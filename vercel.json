{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "build/client",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|avif|svg|ico|woff2|woff|ttf|otf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self' https://www.figma.com https://embed.figma.com https://*.figma.com; form-action 'self' https://formsubmit.co; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://formsubmit.co https://*.posthog.com https://*.i.posthog.com https://cloudflareinsights.com https://static.cloudflareinsights.com; worker-src 'self' blob:; media-src 'self' blob: data:;"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "^www\\.anviklabs\\.site$" }
      ],
      "destination": "https://anviklabs.site/:path*",
      "statusCode": 301
    },
    {
      "source": "/work",
      "destination": "/works",
      "statusCode": 301
    },
    {
      "source": "/work/",
      "destination": "/works",
      "statusCode": 301
    },
    {
      "source": "/works/arcane-studio",
      "destination": "/works",
      "statusCode": 301
    },
    {
      "source": "/works/big-baby-tape-magazine",
      "destination": "/works",
      "statusCode": 301
    },
    {
      "source": "/journal/production-ready-architecture-audit",
      "destination": "/journal/production-readiness-architecture-audit",
      "statusCode": 301
    },
    {
      "source": "/:path(.+)/",
      "destination": "/:path",
      "statusCode": 301
    }
  ]
}
